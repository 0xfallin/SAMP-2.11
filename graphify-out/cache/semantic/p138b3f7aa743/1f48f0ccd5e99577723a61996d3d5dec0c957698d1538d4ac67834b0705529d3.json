{"nodes": [{"id": "app/src/main/cpp/samp/cmakelists/samp_library", "label": "samp Shared Library Target", "file_type": "code", "source_file": "app/src/main/cpp/samp/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app/src/main/cpp/samp/cmakelists/samp_optimize_option", "label": "SAMP_OPTIMIZE (-O3 Always)", "file_type": "concept", "source_file": "app/src/main/cpp/samp/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The NDK toolchain adds -O0 for Debug after CMAKE_CXX_FLAGS, so -O3 in CMAKE_CXX_FLAGS was ignored in assembleDebug builds and native code ran unoptimised; the stack protector is dropped because it costs a canary check on every function with a local array on hot render/network paths."}, {"id": "app/src/main/cpp/samp/cmakelists/samp_lto_option", "label": "SAMP_LTO (ThinLTO)", "file_type": "concept", "source_file": "app/src/main/cpp/samp/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ThinLTO produces a smaller/faster .so but is much slower and heavier to link, so it defaults OFF because building inside Termux/proot can run out of RAM."}, {"id": "app/src/main/cpp/samp/cmakelists/source_glob", "label": "Recursive Source Glob (CONFIGURE_DEPENDS)", "file_type": "concept", "source_file": "app/src/main/cpp/samp/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One recursive glob replaces ten hand-written depth patterns while keeping the same file set, and CONFIGURE_DEPENDS re-globs when files are added or removed."}, {"id": "app/src/main/cpp/samp/cmakelists/bass_audio", "label": "BASS Audio Library (vendored)", "file_type": "code", "source_file": "app/src/main/cpp/samp/CMakeLists.txt", "source_location": null, "source_url": null, "ca